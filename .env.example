# Copy to .env and fill in. Never commit .env or real passwords.

DATABASE_URL=postgres://vbs:YOUR_LOCAL_DB_PASSWORD@127.0.0.1:5432/vbs
POSTGRES_PASSWORD=YOUR_LOCAL_DB_PASSWORD

# Local s3mock (docker compose). In AWS production, omit S3_ENDPOINT and use RDS + real S3 — see docs/aws-deploy.md
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=YOUR_LOCAL_S3_ACCESS_KEY
S3_SECRET_KEY=YOUR_LOCAL_S3_SECRET_KEY
S3_BUCKET=vbs
S3_PUBLIC_URL=/files
AUTH_PASSWORD=YOUR_LOCAL_ADMIN_PASSWORD
SESSION_SECRET=
APP_PUBLIC_URL=http://localhost:5173

# Playwright E2E — passwords come from .env only (empty persona fields inherit E2E_DEFAULT_PASSWORD, then AUTH_PASSWORD)
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:3000
E2E_ORG_ID=org-cornerstone-seattle
E2E_PLAYWRIGHT_HEADLESS=false
# Parallel workers (default: all cores when headless, 1 when headed so you can watch one browser)
E2E_WORKERS=
E2E_DEFAULT_PASSWORD=
E2E_PLATFORM_ADMIN_USERNAME=admin
E2E_PLATFORM_ADMIN_PASSWORD=
E2E_ORG_ADMIN_USERNAME=pcheaz@gmail.com
E2E_ORG_ADMIN_PASSWORD=
E2E_REGISTRATION_ADMIN_USERNAME=patti.tam@gmail.com
E2E_REGISTRATION_ADMIN_PASSWORD=
E2E_ORG_WRITE_USERNAME=mark.yamashita
E2E_ORG_WRITE_PASSWORD=
E2E_ORG_READ_USERNAME=e2e.org.read@cornerstone.test
E2E_ORG_READ_PASSWORD=
E2E_TEAM_ADMIN_USERNAME=e2e.team.admin@cornerstone.test
E2E_TEAM_ADMIN_PASSWORD=
E2E_TEAM_NAME=E2E Test Team

# Email (optional — without SMTP, messages log to the API console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS via Twilio (optional — without these, SMS log to the API console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
OPENAI_API_KEY=
