# Production environment (ECS / App Runner / EC2). Inject via Secrets Manager — do not commit filled copy.

NODE_ENV=production
PORT=3000

SESSION_SECRET=generate-a-long-random-string

DATABASE_URL=postgres://USER:PASSWORD@your-rds-host.region.rds.amazonaws.com:5432/vbs

# Real AWS S3 — leave S3_ENDPOINT unset. Use IAM task role when possible (omit keys).
S3_REGION=us-west-2
S3_BUCKET=your-vbs-uploads-bucket
S3_PUBLIC_URL=https://vbs.yourchurch.org/files

APP_PUBLIC_URL=https://vbs.yourchurch.org

# Optional: only if not using IAM role for S3
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Email (Amazon SES or other SMTP)
# SMTP_HOST=email-smtp.us-west-2.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@yourchurch.org

# SMS (Twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# AI features
# GEMINI_API_KEY=
# OPENAI_API_KEY=
