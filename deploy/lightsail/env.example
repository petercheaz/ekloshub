# Copied to the instance as /opt/vbs/deploy/lightsail/.env (not committed).
# lightsail-up.sh generates secrets. SITE_ADDRESS should be a hostname (not :80)
# so Caddy can get a Let's Encrypt cert. Default demo host is PUBLIC_IP.sslip.io.

SITE_ADDRESS=REPLACE_WITH_PUBLIC_IP.sslip.io
APP_PUBLIC_URL=https://REPLACE_WITH_PUBLIC_IP.sslip.io
AUTH_PASSWORD=replace-me
SESSION_SECRET=replace-me
POSTGRES_PASSWORD=replace-me
S3_SECRET_KEY=replace-me
PCHEAZ_PASSWORD=replace-me
