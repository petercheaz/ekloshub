# Copied to the instance as /opt/vbs/deploy/lightsail/.env (not committed).
# lightsail-up.sh generates secrets. Override SITE_ADDRESS with a domain for HTTPS.

SITE_ADDRESS=:80
ACME_EMAIL=off
APP_PUBLIC_URL=http://REPLACE_WITH_PUBLIC_IP
AUTH_PASSWORD=replace-me
SESSION_SECRET=replace-me
POSTGRES_PASSWORD=replace-me
S3_SECRET_KEY=replace-me
PCHEAZ_PASSWORD=replace-me
